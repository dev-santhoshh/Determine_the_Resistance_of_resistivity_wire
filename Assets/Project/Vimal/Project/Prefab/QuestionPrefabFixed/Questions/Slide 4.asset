  m_Script: {fileID: 11500000, guid: d01fd2d64a9249049aaa77d5c12a82fe, type: 3}
  m_Name: Slide 4
  m_EditorClassIdentifier: 
  questionText: '4. In this experiment, if we use 90 cm wire instead of 100 cm, the
    new formula would be (L is the length measured from left end):'
  referenceImage: {fileID: 0}
  explanationText: 'Applying balanced Wheatstone bridge condition

    

    P=
    Q(L/(90 - L))'
  options:
  - "P = Q \xD7 (L / (90 \u2212 L))"
  - "P = Q \xD7 ((10 \u2212 L) / L)"
  - "P = L / (Q \xD7 (90 \u2212 L))"
  - D None of the above
  correctOptionIndex: 0
